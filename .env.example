# Copy to .env and fill in your Gigwa connection settings. Everything here is OPTIONAL:
# with no .env at all, the server connects anonymously to the public ICARDA instance.
#
# GIGWA_URL is the base URL without the /rest suffix (it is appended automatically).
# Defaults to https://gigwa.icarda.org:8443/gigwa when unset.
GIGWA_URL=http://localhost:8080/gigwa
# GIGWA_USER / GIGWA_PASS are OPTIONAL: omit BOTH for anonymous (public/read-only) access.
GIGWA_USER=your_user
GIGWA_PASS=your_password
# GIGWA_TIMEOUT=120           # optional, seconds  read/request timeout
# GIGWA_CONNECT_TIMEOUT=10    # optional, seconds  TCP connect only (fail fast if unreachable)

# MCP Server transport settings (optional)
# GIGWA_MCP_PORT=8184        # Set to run in HTTP mode on this port (default: 8184)
#                             # If unset or empty, server runs in STDIO mode
# GIGWA_MCP_HOST=127.0.0.1   # Bind address for HTTP mode (default: 127.0.0.1, loopback only)
#                             # Set to 0.0.0.0 to accept connections from other hosts
#                             # (the Docker image sets this to 0.0.0.0 automatically)
